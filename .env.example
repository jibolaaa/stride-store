# Get these from dashboard.paystack.com -> Settings -> API Keys (TEST mode)
# Add this in Vercel: Project -> Settings -> Environment Variables
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# Back office (/office): any Postgres database. On Vercel, connecting a Neon
# database (Storage -> Create Database -> Neon) sets this for you.
DATABASE_URL=postgres://user:password@localhost:5432/stride

# Optional: the key that signs back office sign-ins. If it isn't set, one is
# made from DATABASE_URL.
# JWT_SECRET=a-long-random-string
